<?xml version="1.0"?>
<ruleset name="Extensions for Polylang">
	<description>WordPress Coding Standards for Extensions for Polylang.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Class files under src/ follow PSR-4 names. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- The working copy may use CRLF line endings (see .gitattributes). -->
		<exclude name="Generic.Files.LineEndings"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="extensions-for-polylang"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="extensions_for_polylang"/>
				<element value="Ryadel\ExtensionsForPolylang"/>
			</property>
		</properties>
	</rule>
</ruleset>
